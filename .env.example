# Runtime — set TELEGRAM_BOT_TOKEN in your shell or hosting dashboard
TELEGRAM_BOT_TOKEN=

# Primary group (X-Chaharsotoon). Get id via @userinfobot or bot logs.
TELEGRAM_GROUP_ID=

# Optional comma-separated extra group ids
TELEGRAM_ALLOWED_GROUP_IDS=

# polling (local dev) | webhook (production)
BOT_MODE=polling

# Webhook (production)
WEBHOOK_URL=https://your-app.fly.dev
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=

HOST=0.0.0.0
PORT=8081

# SQLite path — used when DATABASE_URL is empty
DATABASE_PATH=data/charbot.db

# Optional Neon/Postgres URL (pooled). Empty = sqlite.
DATABASE_URL=

FOLLOWUP_ENABLED=true
FOLLOWUP_INTERVAL_HOURS=24
