# Runtime — set TELEGRAM_BOT_TOKEN in your shell or hosting dashboard.
# Never commit real tokens, DATABASE_URL, or webhook secrets.

TELEGRAM_BOT_TOKEN=

# Primary Telegram group id (required for outbound jobs / group gating).
# Get id via @userinfobot or bot logs when the bot is added to the group.
TELEGRAM_GROUP_ID=

# Optional comma-separated extra group ids
TELEGRAM_ALLOWED_GROUP_IDS=

# polling (local dev) | webhook (production)
BOT_MODE=polling

# Webhook (production)
WEBHOOK_URL=https://your-app.fly.dev
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=

HOST=0.0.0.0
PORT=8081

# SQLite path — used when DATABASE_URL is empty
DATABASE_PATH=data/charbot.db

# Optional Neon/Postgres URL (pooled). Empty = sqlite.
DATABASE_URL=

FOLLOWUP_ENABLED=true
FOLLOWUP_INTERVAL_HOURS=24

# Org / group / project seeds (public defaults are generic example-*).
# Production must set these to match existing Neon rows (upsert by slug / chat id).
# CHARBOT_ORG_SLUG=example-org
# CHARBOT_ORG_NAME=Example Org
# CHARBOT_GROUP_TITLE=Example Board
# CHARBOT_GROUP_CHAT_ID=
# CHARBOT_PROJECT_SLUG=demo-project
# CHARBOT_PROJECT_NAME=Demo Project
# CHARBOT_ROLE_KAWE=Chair; coordination and tech
# CHARBOT_ROLE_HAMED=Lead; design
# CHARBOT_NOTE_GHAZAL=Marketing, branding, design
# Comma-separated title/description keywords that auto-link to CHARBOT_PROJECT_*
# CHARBOT_PROJECT_MATCH=demo,client-x

# Telegram @usernames for member keys (empty = no hard-coded handles).
# Format: key:username,key:username
# CHARBOT_TG_USERNAMES=kawe:alice_tg,hamed:bob_tg,saman:saman_tg,mohammadreza:mreza_tg

# HTTP ASR. Prefer OpenRouter (many models, one key). Fly has no faster-whisper.
# OPENROUTER_API_KEY=
# CHARBOT_ASR_MODEL=deepgram/nova-3
# Fallback chain in code: OpenRouter nova-3 → openai/whisper-large-v3 → OpenAI gpt-4o-mini-transcribe
# OPENAI_API_KEY=
# CHARBOT_LLM_BASE_URL=https://api.openai.com/v1
# CHARBOT_LLM_API_KEY=
